{
  "name": "csapp-gitbook",
  "version": "1.0.0",
  "private": true,
  "description": "CSAPP 第三版中文 GitBook 阅读站",
  "scripts": {
    "sync": "python scripts/sync.py",
    "sync:update": "python scripts/sync.py --update",
    "test": "python -m unittest discover -s scripts -p test_*.py",
    "build": "honkit build . _book",
    "check": "python scripts/check_site.py",
    "serve": "honkit serve . _book"
  },
  "engines": { "node": ">=24" },
  "devDependencies": {
    "honkit": "7.0.0",
    "gitbook-plugin-csapp": "file:plugins/csapp",
    "gitbook-plugin-search-pro": "2.0.2"
  }
}
